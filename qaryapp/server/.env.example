# Koneksi PostgreSQL lokal (wajib)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qaryapp

# Port HTTP server Fastify (bawaan: 3000)
PORT=3000

# Lingkungan eksekusi: development | test | production
NODE_ENV=development

# Masa berlaku sesi dalam hari (bawaan: 30)
SESSION_TTL_DAYS=30

# Set true jika berjalan di belakang reverse proxy (Nginx/Caddy/Cloudflare)
TRUST_PROXY=false

# Origin frontend yang diizinkan saat pengembangan (opsional, pisahkan koma jika lebih dari satu)
ALLOWED_ORIGIN=http://localhost:5173
