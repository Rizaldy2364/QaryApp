{
  "name": "qaryapp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file=.env src/db/migrate.ts down",
    "cleanup": "tsx --env-file=.env src/scripts/cleanup.ts",
    "test": "vitest run",
    "smoke": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.3.2",
    "kysely": "^0.28.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "cookie": "^1.0.2"
  }
}
